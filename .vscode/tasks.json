{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OpenGL Project",
            "type": "shell",
            "command": "C:/msys64/mingw64/bin/g++.exe",
            "args": [
    "-g",
    "-std=c++17",
    "-DGLEW_STATIC",
    "-I", "C:/Program Files/glfw-3.4.bin.WIN64/include",
    "-I", "C:/Program Files/glew-2.3.1/include",
    "-I", "C:/Program Files/glm-master/glm-master",
    "${workspaceFolder}/main.cpp",
    "${workspaceFolder}/Shader.cpp",
    "${workspaceFolder}/vertexShader.cpp",
    "${workspaceFolder}/fragmentShader.cpp",
    "${workspaceFolder}/Pyramid.cpp",
    "-o", "${workspaceFolder}/main.exe",
    "-L", "C:/Program Files/glfw-3.4.bin.WIN64/lib-mingw-w64",
    "-L", "C:/Program Files/glew-2.3.1/lib/Release/x64",
    "-lglew32s", "-lglfw3", "-lopengl32", "-lgdi32", "-luser32"
],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compiles main.cpp with GLFW, GLEW (static), and GLM"
        }
    ]
}